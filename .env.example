# Copy to .env and adjust. Defaults match docker-compose.yml.
CFR_ENV=dev

# --- Postgres ---
CFR_STATE_DATABASE_URL=postgresql+psycopg://cfr:cfr@localhost:5432/cfr_state
CFR_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://cfr:cfr@localhost:5432/cfr_dbos

# --- S3-compatible store (V1 variable names, see cfr-v1/file.txt) ---
# Defaults point at the local RustFS container (LDR-0009).
S3_ENDPOINT=http://localhost:9000
REGION_NAME=us-east-1
S3_ACCESSKEY=cfr-dev
S3_SECRET=cfr-dev-secret
# Optional separate credentials for the restricted bucket (LDR-0008)
# S3_RESTRICTED_ACCESSKEY=
# S3_RESTRICTED_SECRET=
# S3 connection pool; keep >= batch + realtime queue concurrency (P6)
S3_MAX_POOL_CONNECTIONS=64
# CA bundle for TLS verification; empty = system trust store. verify=False is never used.
# S3_CA_BUNDLE=
# Bucket name overrides (default cfr-v2-<env>-artifacts[-restricted])
# CFR_ARTIFACT_BUCKET=
# CFR_RESTRICTED_ARTIFACT_BUCKET=

# --- Runtime lanes (LDR-0002) ---
CFR_BATCH_QUEUE_CONCURRENCY=50
CFR_REALTIME_QUEUE_CONCURRENCY=10

# --- Intake (C01) ---
# Release manifest pinned on every admitted run: registry/releases/<id>.yaml (P4)
CFR_RELEASE_ID=cfr-v2-phase-b
# CFR_REGISTRY_DIR=registry
# V1 toxic_words.txt; without it profanity is not masked (same as V1)
# CFR_TOXIC_WORDS_FILE=
CFR_INTAKE_MAX_WORKERS=8
# ee-config file read by ee_utils redaction (`redaction:`), safechain and telemetry (`elf:`)
# CONFIG_PATH=config_gpt.yml

# --- BigQuery (prod client, port of cfr-v1/src/sql/fetch_client_prod.py) ---
# GCP_PROJECT_ID=
# Service-account key JSON, inline. A secret: keep it out of committed files.
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_BQ_API_ENDPOINT=
