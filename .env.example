# Copy to .env and adjust. Defaults match docker-compose.yml.
CFR_ENV=dev

# --- Postgres ---
CFR_STATE_DATABASE_URL=postgresql://cfr:cfr@localhost:5432/cfr_state
# Driver: auto (psycopg 3, else psycopg2), psycopg, or psycopg2
# CFR_DB_DRIVER=auto

# --- S3-compatible store (V1 variable names, see cfr-v1/file.txt) ---
# Defaults point at the local RustFS container (LDR-0009).
S3_ENDPOINT=http://localhost:9000
REGION_NAME=us-east-1
S3_ACCESSKEY=cfr-dev
S3_SECRET=cfr-dev-secret
# Optional separate credentials for the restricted bucket (LDR-0008)
# S3_RESTRICTED_ACCESSKEY=
# S3_RESTRICTED_SECRET=
# S3 connection pool; keep >= batch + realtime queue concurrency (P6)
S3_MAX_POOL_CONNECTIONS=64
# CA bundle for TLS verification; empty = system trust store. verify=False is never used.
# S3_CA_BUNDLE=
# Behind a TLS-inspecting proxy: verify against the OS trust store (truststore), as V1 did.
# Set here, not in code: it must take effect before boto3 is imported.
# CFR_TRUSTSTORE=1
# Bucket name overrides (default cfr-v2-<env>-artifacts[-restricted])
# CFR_ARTIFACT_BUCKET=
# CFR_RESTRICTED_ARTIFACT_BUCKET=

# --- Runtime (LDR-0011) ---
# Per-process lane concurrency; deployment capacity = per process x processes
CFR_BATCH_QUEUE_CONCURRENCY=50
CFR_REALTIME_QUEUE_CONCURRENCY=10
# CFR_QUEUE_POLLING_INTERVAL_SEC=1.0
# Lease owner name; default <hostname>:<pid>
# CFR_EXECUTOR_ID=
# A worker silent for this long is presumed dead and its jobs are reclaimed
# CFR_LEASE_SEC=30
# CFR_HEARTBEAT_SEC=10
# CFR_MAX_JOB_ATTEMPTS=5

# --- ee-config ---
# Read by ee_config.load_config() for redaction (`redaction:`), safechain (`idaas:`, `models:`)
# and telemetry (`elf:`). Copy config/config_gpt.example.yml to config/config_gpt.yml.
# Relative paths resolve against the working directory; use an absolute path in deployments.
CONFIG_PATH=config/config_gpt.yml

# --- Model gateway (P5, LDR-0013) ---
# Which model: the key under `models:` in CONFIG_PATH ("3" = gpt-5, as in V1); safechain reads the rest.
# Its `redaction: mode:` must be `disabled`: transcripts are redacted at intake, and the client refuses otherwise.
# CFR_LLM_MODEL_KEY=3
# CFR_LLM_MODEL_ID=gpt-5
# CFR_LLM_MAX_COMPLETION_TOKENS=32768
# CFR_LLM_TEMPERATURE=0.0
# Per worker process, shared by every case it runs. Keep processes x concurrency within the gateway quota.
# CFR_LLM_MAX_CONCURRENCY=32
# Optional steady pacing on top of the cap (unset = none)
# CFR_LLM_REQUESTS_PER_MINUTE=
# Retries inside one call (timeouts, 5xx, connection errors, 401); 429s don't count, the deadline bounds them
# CFR_LLM_MAX_ATTEMPTS=4
# CFR_LLM_BACKOFF_BASE_SEC=2
# CFR_LLM_BACKOFF_MAX_SEC=30
# CFR_LLM_ATTEMPT_TIMEOUT_SEC=360
# CFR_LLM_CALL_DEADLINE_SEC=1200
# CFR_LLM_INVALID_OUTPUT_ATTEMPTS=2
# Have Azure enforce the output JSON schema exactly (schemas must list every property as required
# and set additionalProperties: false)
# CFR_LLM_STRICT_SCHEMA=false
# A 429 pauses every call in the process: base doubling per episode up to max, at least the Retry-After
# CFR_LLM_RATE_LIMIT_COOLDOWN_SEC=5
# CFR_LLM_RATE_LIMIT_COOLDOWN_MAX_SEC=60

# --- Telemetry (LDR-0012) ---
# Enterprise: ee-logging exports using the `elf:` section of CONFIG_PATH (above).
# Dev only (ee-logging absent): export to the local collector started with
# `docker compose --profile observability up -d`. Unset = no export.
# CFR_OTLP_ENDPOINT=http://localhost:4318

# --- C04 routing (LDR-0021) ---
# Leave unset: each snapshot's LightRAG store is lightrag_store_<first 12 of its hash>, and the
# worker finds it from the release manifest's procedure_snapshot. Set it only to keep the store
# elsewhere; it must then have been built from that snapshot.
# CFR_LIGHTRAG_WORKDIR=/path/to/store

# --- Intake (C01) ---
# Release manifest pinned on every admitted run: registry/releases/<id>.yaml (P4)
CFR_RELEASE_ID=cfr-v2-phase-e
# CFR_REGISTRY_DIR=registry
# V1 toxic_words.txt; without it profanity is not masked (same as V1)
# CFR_TOXIC_WORDS_FILE=
CFR_INTAKE_MAX_WORKERS=8
# LUMI baseline in the same BigQuery job as the cases (LDR-0014); 0 = cases only
# CFR_INTAKE_BASELINE=1

# --- BigQuery (prod client, port of cfr-v1/src/sql/fetch_client_prod.py) ---
# GCP_PROJECT_ID=
# Service-account key JSON, inline. A secret: keep it out of committed files.
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_BQ_API_ENDPOINT=

# Procedure source (LDR-0019): stub until API access is granted. The host stays out of the repo.
# CFR_CONFLUENCE_BASE_URL=
# CFR_CONFLUENCE_LANDING_PAGE=
# CFR_CONFLUENCE_API_TOKEN=

# Embeddings for the procedure index (LDR-0019). Defaults: key "4", text-embedding-3-large, 3072.
# CFR_EMBEDDING_MODEL_KEY=4
# CFR_EMBEDDING_MODEL_ID=text-embedding-3-large
# CFR_EMBEDDING_DIMENSIONS=3072
# CFR_EMBEDDING_BATCH_SIZE=64
# CFR_EMBEDDING_MAX_CONCURRENCY=5
# CFR_EMBEDDING_ATTEMPT_TIMEOUT_SEC=120
# CFR_EMBEDDING_CALL_DEADLINE_SEC=600   # lightrag-build uses at least 1800 and at most 3 at once
